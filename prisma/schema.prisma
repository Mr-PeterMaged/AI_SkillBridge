// SkillBridge AI — database schema
// Postgres (Neon) via Prisma. Run `npx prisma migrate dev` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Users are provisioned lazily on first authenticated request —
// clerkUserId is the source of truth, this table mirrors it so we
// can attach foreign keys and app-specific fields (plan, etc).
// ---------------------------------------------------------------
model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  plan        Plan     @default(FREE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses        Analysis[]
  quizAttempts    QuizAttempt[]
  weeklyCheckIns  WeeklyCheckIn[]
  jobApplications JobApplication[]

  @@index([clerkUserId])
}

enum Plan {
  FREE
  STARTER
  PRO
  JOB_SPRINT
  ANNUAL_STUDENT
}

enum TargetRole {
  JUNIOR_FRONTEND_DEVELOPER
  JUNIOR_BACKEND_DEVELOPER
  JUNIOR_DATA_ANALYST
}

enum ExperienceLevel {
  STUDENT
  FRESH_GRADUATE
  JUNIOR
}

enum WeeklyHours {
  H3
  H5
  H8
  H10_PLUS
}

enum AnalysisStatus {
  DRAFT
  EXTRACTING
  AWAITING_REVIEW
  SCORED
  ROADMAP_READY
  FAILED
}

// One "SkillBridge run": a CV + a JD, evaluated against a target role.
// Raw CV text is intentionally NOT stored once structured skills are
// extracted and confirmed — see lib/db/retention.ts.
model Analysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetRole      TargetRole
  experienceLevel ExperienceLevel
  weeklyHours     WeeklyHours

  // Parsed input text. Nullable once purged (see privacy/delete flow).
  cvText             String?
  jobDescriptionText String?

  status           AnalysisStatus @default(DRAFT)
  readinessScore   Int? // 0-100, computed server-side, never by the LLM
  scoreBreakdown   Json? // { criticalCoverage, importantCoverage, evidenceCoverage }
  candidateSummary String?
  jobSummary       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateSkills        CandidateSkill[]
  jobRequirements        JobRequirement[]
  skillGaps              SkillGap[]
  roadmap                Roadmap?
  projectRecommendations ProjectRecommendation[]
  evidenceItems          EvidenceItem[]
  readinessSnapshots     ReadinessSnapshot[]
  weeklyCheckIns         WeeklyCheckIn[]
  jobApplications        JobApplication[]
  quizAttempts           QuizAttempt[]

  @@index([userId])
  @@index([userId, createdAt])
}

enum SkillCategory {
  TECHNICAL
  TOOL
  SOFT
}

enum SkillStatus {
  MATCHED
  PARTIAL
  MISSING
  USER_ADDED
}

enum SkillMastery {
  FAMILIAR
  PRACTICED
  PROVEN
}

model CandidateSkill {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  name          String
  canonicalName String
  category      SkillCategory
  confidence    Float         @default(0)
  status        SkillStatus   @default(MATCHED)
  mastery       SkillMastery?
  evidence      Json          @default("[]") // string[]
  userConfirmed Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisId])
}

enum RequirementPriority {
  CRITICAL
  IMPORTANT
  NICE_TO_HAVE
}

model JobRequirement {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  name          String
  canonicalName String
  category      SkillCategory
  priority      RequirementPriority
  evidence      Json                @default("[]") // string[], quotes from the JD

  createdAt DateTime @default(now())

  @@index([analysisId])
}

model SkillGap {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  skillName      String
  canonicalName  String
  priority       RequirementPriority
  reason         String              @db.Text
  suggestedProof String              @db.Text
  estimatedHours Int                 @default(4)

  createdAt DateTime @default(now())

  @@index([analysisId])
}

model Roadmap {
  id         String   @id @default(cuid())
  analysisId String   @unique
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  durationWeeks Int      @default(4)
  createdAt     DateTime @default(now())

  weeks RoadmapWeek[]
}

model RoadmapWeek {
  id        String  @id @default(cuid())
  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  weekNumber        Int
  focus             String
  learningObjective String @db.Text
  estimatedHours    Int
  resources         Json   @default("[]") // { title, url }[]

  tasks RoadmapTask[]

  @@unique([roadmapId, weekNumber])
  @@index([roadmapId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
}

enum EvidenceType {
  GITHUB
  DEMO_URL
  PORTFOLIO_URL
  CASE_STUDY
  NOTE
}

model RoadmapTask {
  id            String      @id @default(cuid())
  roadmapWeekId String
  roadmapWeek   RoadmapWeek @relation(fields: [roadmapWeekId], references: [id], onDelete: Cascade)

  title       String
  description String     @db.Text
  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  evidenceUrl  String?
  evidenceType EvidenceType?
  notes        String?       @db.Text

  evidenceItems  EvidenceItem[]
  weeklyCheckIns WeeklyCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roadmapWeekId])
}

enum ProjectSource {
  STATIC
  AI_GENERATED
}

model ProjectRecommendation {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title           String
  description     String @db.Text
  requiredSkills  Json   @default("[]") // string[]
  deliverables    Json   @default("[]") // string[]
  githubChecklist Json   @default("[]") // string[]

  // Phase 3 — Portfolio Project Builder. Null/default on older STATIC rows.
  source              ProjectSource @default(STATIC)
  valueProposition    String?       @db.Text
  difficulty          String?
  estimatedHours      Int?
  userStories         Json          @default("[]") // string[]
  suggestedStack      Json          @default("[]") // string[]
  featureChecklist    Json          @default("[]") // string[]
  buildPlan           Json          @default("[]") // { day, focus, tasks: string[] }[]
  readmeTemplate      String?       @db.Text
  deploymentChecklist Json          @default("[]") // string[]
  // Deterministic — computed from the analysis's own skillGaps, never by the AI.
  skillCoverage       Json          @default("[]") // { skill, isGapCovered, howCovered }[]
  addedToRoadmap      Boolean       @default(false)

  createdAt DateTime @default(now())

  @@index([analysisId])
}

// ---------------------------------------------------------------
// Phase 2 — Evidence & Reassessment.
// EvidenceItem is deliberately NOT a "verification" record: it is
// user-submitted proof (a link or a written reflection) that mentors
// and employers can review. Whether it actually proves a skill is a
// judgment call the user makes explicitly (provesSkills), never an
// automatic AI inference — see the reassess route.
// ---------------------------------------------------------------
model EvidenceItem {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  roadmapTaskId String?
  roadmapTask   RoadmapTask? @relation(fields: [roadmapTaskId], references: [id], onDelete: SetNull)

  type              EvidenceType
  url               String?
  reflectionBuilt   String?      @db.Text // "What did you build?"
  reflectionLearned String?      @db.Text // "What did you learn?"
  provesSkills      Json         @default("[]") // string[] canonical skill names the user says this proves

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumeBullets ResumeBullet[]

  @@index([analysisId])
  @@index([roadmapTaskId])
}

enum SnapshotKind {
  BASELINE
  REASSESSMENT
}

// A point-in-time copy of the deterministic score, so the Evidence
// Timeline and "before/after" reassessment UI can render history
// without recomputing anything retroactively.
model ReadinessSnapshot {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  kind           SnapshotKind
  readinessScore Int
  scoreBreakdown Json

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([analysisId, createdAt])
}

enum QuizSkill {
  REACT_FUNDAMENTALS
  TYPESCRIPT_FUNDAMENTALS
  REST_API_FUNDAMENTALS
  GIT_FUNDAMENTALS
  SQL_FUNDAMENTALS
  PYTHON_FUNDAMENTALS
  DATA_VISUALIZATION_FUNDAMENTALS
}

enum QuizResultStatus {
  LEARNING
  QUIZ_COMPLETED
  STRONG_QUIZ_RESULT
}

model QuizAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  skill   QuizSkill
  score   Int
  total   Int
  status  QuizResultStatus
  answers Json             @default("[]") // { questionId, selectedOptionId, correct }[]

  createdAt DateTime @default(now())

  @@index([userId, skill, createdAt])
  @@index([analysisId])
}

enum CheckInResponse {
  COMPLETED
  MADE_PROGRESS
  GOT_STUCK
  DID_NOT_START
}

model WeeklyCheckIn {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  roadmapTaskId String?
  roadmapTask   RoadmapTask? @relation(fields: [roadmapTaskId], references: [id], onDelete: SetNull)

  response       CheckInResponse
  blocker        String?         @db.Text
  availableHours Int?
  aiSuggestion   String          @db.Text
  adjustedTask   String?         @db.Text

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([analysisId, createdAt])
  @@index([roadmapTaskId])
}

model ResumeBullet {
  id             String       @id @default(cuid())
  evidenceItemId String
  evidenceItem   EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)

  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([evidenceItemId])
}

enum ApplicationStatus {
  SAVED
  PREPARING
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model JobApplication {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  jobTitle       String
  company        String
  applicationUrl String?
  status         ApplicationStatus @default(SAVED)
  deadline       DateTime?
  notes          String?           @db.Text
  readinessScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([analysisId])
}
