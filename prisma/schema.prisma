// SkillBridge AI — database schema
// Postgres (Neon) via Prisma. Run `npx prisma migrate dev` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Users are provisioned lazily on first authenticated request —
// clerkUserId is the source of truth, this table mirrors it so we
// can attach foreign keys and app-specific fields (plan, etc).
// ---------------------------------------------------------------
model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  plan        Plan     @default(FREE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  analyses              Analysis[]
  quizAttempts          QuizAttempt[]
  weeklyCheckIns        WeeklyCheckIn[]
  jobApplications       JobApplication[]
  promoRedemptions      PromoRedemption[]
  referralAttributions  ReferralAttribution[]
  subscriptions         Subscription[]
  manualPaymentRequests ManualPaymentRequest[]
  planUsageCycles       PlanUsageCycle[]

  @@index([clerkUserId])
}

enum Plan {
  FREE
  STARTER
  PRO
  JOB_SPRINT
  ANNUAL_STUDENT
}

enum BillingInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum ManualPaymentStatus {
  PENDING_PAYMENT
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum TargetRole {
  JUNIOR_FRONTEND_DEVELOPER
  JUNIOR_BACKEND_DEVELOPER
  JUNIOR_DATA_ANALYST
  FULL_STACK_DEVELOPER
  MOBILE_APP_DEVELOPER
  QA_TEST_ENGINEER
  DEVOPS_ENGINEER
  UI_UX_DESIGNER
  DIGITAL_MARKETING_SPECIALIST
  CYBERSECURITY_ANALYST
  CLOUD_ENGINEER
  DATA_ENGINEER
  PRODUCT_MANAGER
  TECHNICAL_WRITER
  IT_SUPPORT_SPECIALIST
}

enum ExperienceLevel {
  STUDENT
  FRESH_GRADUATE
  JUNIOR
}

enum WeeklyHours {
  H3
  H5
  H8
  H10_PLUS
}

enum AnalysisStatus {
  DRAFT
  EXTRACTING
  AWAITING_REVIEW
  SCORED
  ROADMAP_READY
  FAILED
}

// One "SkillBridge run": a CV + a JD, evaluated against a target role.
// Raw CV text is intentionally NOT stored once structured skills are
// extracted and confirmed — see lib/db/retention.ts.
model Analysis {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetRole      TargetRole
  experienceLevel ExperienceLevel
  weeklyHours     WeeklyHours

  // Parsed input text. Nullable once purged (see privacy/delete flow).
  cvText             String?
  jobDescriptionText String?

  status           AnalysisStatus @default(DRAFT)
  readinessScore   Int? // 0-100, computed server-side, never by the LLM
  scoreBreakdown   Json? // { criticalCoverage, importantCoverage, evidenceCoverage }
  candidateSummary String?
  jobSummary       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateSkills        CandidateSkill[]
  jobRequirements        JobRequirement[]
  skillGaps              SkillGap[]
  roadmap                Roadmap?
  projectRecommendations ProjectRecommendation[]
  evidenceItems          EvidenceItem[]
  readinessSnapshots     ReadinessSnapshot[]
  weeklyCheckIns         WeeklyCheckIn[]
  jobApplications        JobApplication[]
  quizAttempts           QuizAttempt[]

  @@index([userId])
  @@index([userId, createdAt])
}

enum SkillCategory {
  TECHNICAL
  TOOL
  SOFT
}

enum SkillStatus {
  MATCHED
  PARTIAL
  MISSING
  USER_ADDED
}

enum SkillMastery {
  FAMILIAR
  PRACTICED
  PROVEN
}

model CandidateSkill {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  name          String
  canonicalName String
  category      SkillCategory
  confidence    Float         @default(0)
  status        SkillStatus   @default(MATCHED)
  mastery       SkillMastery?
  evidence      Json          @default("[]") // string[]
  userConfirmed Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisId])
}

enum RequirementPriority {
  CRITICAL
  IMPORTANT
  NICE_TO_HAVE
}

model JobRequirement {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  name          String
  canonicalName String
  category      SkillCategory
  priority      RequirementPriority
  evidence      Json                @default("[]") // string[], quotes from the JD

  createdAt DateTime @default(now())

  @@index([analysisId])
}

model SkillGap {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  skillName      String
  canonicalName  String
  priority       RequirementPriority
  reason         String              @db.Text
  suggestedProof String              @db.Text
  estimatedHours Int                 @default(4)

  createdAt DateTime @default(now())

  @@index([analysisId])
}

model Roadmap {
  id         String   @id @default(cuid())
  analysisId String   @unique
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  durationWeeks Int      @default(4)
  createdAt     DateTime @default(now())

  weeks RoadmapWeek[]
}

model RoadmapWeek {
  id        String  @id @default(cuid())
  roadmapId String
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  weekNumber        Int
  focus             String
  learningObjective String @db.Text
  estimatedHours    Int
  resources         Json   @default("[]") // { title, url }[]

  tasks RoadmapTask[]

  @@unique([roadmapId, weekNumber])
  @@index([roadmapId])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
}

enum EvidenceType {
  GITHUB
  DEMO_URL
  PORTFOLIO_URL
  CASE_STUDY
  NOTE
}

model RoadmapTask {
  id            String      @id @default(cuid())
  roadmapWeekId String
  roadmapWeek   RoadmapWeek @relation(fields: [roadmapWeekId], references: [id], onDelete: Cascade)

  title       String
  description String     @db.Text
  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  evidenceUrl  String?
  evidenceType EvidenceType?
  notes        String?       @db.Text

  evidenceItems  EvidenceItem[]
  weeklyCheckIns WeeklyCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roadmapWeekId])
}

enum ProjectSource {
  STATIC
  AI_GENERATED
}

model ProjectRecommendation {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  title           String
  description     String @db.Text
  requiredSkills  Json   @default("[]") // string[]
  deliverables    Json   @default("[]") // string[]
  githubChecklist Json   @default("[]") // string[]

  // Phase 3 — Portfolio Project Builder. Null/default on older STATIC rows.
  source              ProjectSource @default(STATIC)
  valueProposition    String?       @db.Text
  difficulty          String?
  estimatedHours      Int?
  userStories         Json          @default("[]") // string[]
  suggestedStack      Json          @default("[]") // string[]
  featureChecklist    Json          @default("[]") // string[]
  buildPlan           Json          @default("[]") // { day, focus, tasks: string[] }[]
  readmeTemplate      String?       @db.Text
  deploymentChecklist Json          @default("[]") // string[]
  // Deterministic — computed from the analysis's own skillGaps, never by the AI.
  skillCoverage       Json          @default("[]") // { skill, isGapCovered, howCovered }[]
  addedToRoadmap      Boolean       @default(false)

  createdAt DateTime @default(now())

  @@index([analysisId])
}

// ---------------------------------------------------------------
// Phase 2 — Evidence & Reassessment.
// EvidenceItem is deliberately NOT a "verification" record: it is
// user-submitted proof (a link or a written reflection) that mentors
// and employers can review. Whether it actually proves a skill is a
// judgment call the user makes explicitly (provesSkills), never an
// automatic AI inference — see the reassess route.
// ---------------------------------------------------------------
model EvidenceItem {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  roadmapTaskId String?
  roadmapTask   RoadmapTask? @relation(fields: [roadmapTaskId], references: [id], onDelete: SetNull)

  type              EvidenceType
  url               String?
  reflectionBuilt   String?      @db.Text // "What did you build?"
  reflectionLearned String?      @db.Text // "What did you learn?"
  provesSkills      Json         @default("[]") // string[] canonical skill names the user says this proves

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumeBullets ResumeBullet[]

  @@index([analysisId])
  @@index([roadmapTaskId])
}

enum SnapshotKind {
  BASELINE
  REASSESSMENT
}

// A point-in-time copy of the deterministic score, so the Evidence
// Timeline and "before/after" reassessment UI can render history
// without recomputing anything retroactively.
model ReadinessSnapshot {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  kind           SnapshotKind
  readinessScore Int
  scoreBreakdown Json

  createdAt DateTime @default(now())

  @@index([analysisId])
  @@index([analysisId, createdAt])
}

enum QuizSkill {
  REACT_FUNDAMENTALS
  TYPESCRIPT_FUNDAMENTALS
  REST_API_FUNDAMENTALS
  GIT_FUNDAMENTALS
  SQL_FUNDAMENTALS
  PYTHON_FUNDAMENTALS
  DATA_VISUALIZATION_FUNDAMENTALS
}

enum QuizResultStatus {
  LEARNING
  QUIZ_COMPLETED
  STRONG_QUIZ_RESULT
}

model QuizAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  skill   QuizSkill
  score   Int
  total   Int
  status  QuizResultStatus
  answers Json             @default("[]") // { questionId, selectedOptionId, correct }[]

  createdAt DateTime @default(now())

  @@index([userId, skill, createdAt])
  @@index([analysisId])
}

enum CheckInResponse {
  COMPLETED
  MADE_PROGRESS
  GOT_STUCK
  DID_NOT_START
}

model WeeklyCheckIn {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  roadmapTaskId String?
  roadmapTask   RoadmapTask? @relation(fields: [roadmapTaskId], references: [id], onDelete: SetNull)

  response       CheckInResponse
  blocker        String?         @db.Text
  availableHours Int?
  aiSuggestion   String          @db.Text
  adjustedTask   String?         @db.Text

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([analysisId, createdAt])
  @@index([roadmapTaskId])
}

model ResumeBullet {
  id             String       @id @default(cuid())
  evidenceItemId String
  evidenceItem   EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)

  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([evidenceItemId])
}

enum ApplicationStatus {
  SAVED
  PREPARING
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

model JobApplication {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  jobTitle       String
  company        String
  applicationUrl String?
  status         ApplicationStatus @default(SAVED)
  deadline       DateTime?
  notes          String?           @db.Text
  readinessScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([analysisId])
}

enum PlatformRole {
  OWNER
  ADMIN
  MARKETING_MANAGER
  SUPPORT_MANAGER
  ANALYST
  VIEWER
  USER
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model PlatformMember {
  id                String       @id @default(cuid())
  clerkUserId       String       @unique
  email             String?
  displayName       String?
  role              PlatformRole @default(USER)
  status            MemberStatus @default(ACTIVE)
  invitedByMemberId String?
  invitedAt         DateTime?
  joinedAt          DateTime?
  suspendedAt       DateTime?
  removedAt         DateTime?
  lastRoleChangedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  invitedBy               PlatformMember?        @relation("MemberInviter", fields: [invitedByMemberId], references: [id], onDelete: SetNull)
  invitedMembers          PlatformMember[]       @relation("MemberInviter")
  invites                 TeamInvite[]
  auditLogs               AdminAuditLog[]        @relation("AuditActor")
  targetAuditLogs         AdminAuditLog[]        @relation("AuditTargetMember")
  reviewedPaymentRequests ManualPaymentRequest[] @relation("PaymentReviewer")

  @@index([role, status])
  @@index([email])
}

model TeamInvite {
  id                String           @id @default(cuid())
  email             String
  role              PlatformRole
  status            TeamInviteStatus @default(PENDING)
  tokenHash         String           @unique
  expiresAt         DateTime
  acceptedAt        DateTime?
  revokedAt         DateTime?
  invitedByMemberId String
  note              String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  invitedBy PlatformMember @relation(fields: [invitedByMemberId], references: [id], onDelete: Restrict)

  @@index([email, status])
  @@index([expiresAt])
}

model AdminAuditLog {
  id             String   @id @default(cuid())
  actorMemberId  String?
  targetMemberId String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  actor        PlatformMember? @relation("AuditActor", fields: [actorMemberId], references: [id], onDelete: SetNull)
  targetMember PlatformMember? @relation("AuditTargetMember", fields: [targetMemberId], references: [id], onDelete: SetNull)

  @@index([actorMemberId, createdAt])
  @@index([targetMemberId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum PromoStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoDuration {
  ONCE
  REPEATING
  FOREVER
}

enum PromoRedemptionStatus {
  PENDING
  REDEEMED
  FAILED
  REFUNDED
  REVOKED
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AmbassadorStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model PromoCampaign {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String?        @db.Text
  status        CampaignStatus @default(ACTIVE)
  startsAt      DateTime?
  endsAt        DateTime?
  internalNotes String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  promoCodes   PromoCode[]
  ambassadors  Ambassador[]
  redemptions  PromoRedemption[]
  attributions ReferralAttribution[]

  @@index([status])
  @@index([startsAt, endsAt])
}

model Ambassador {
  id           String           @id @default(cuid())
  campaignId   String?
  campaign     PromoCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name         String
  organization String?
  publicHandle String           @unique
  contactEmail String?
  referralKey  String           @unique
  status       AmbassadorStatus @default(ACTIVE)
  notes        String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  promoCodes   PromoCode[]
  redemptions  PromoRedemption[]
  attributions ReferralAttribution[]

  @@index([campaignId])
  @@index([status])
}

model PromoCode {
  id                     String         @id @default(cuid())
  code                   String         @unique
  status                 PromoStatus    @default(ACTIVE)
  discountType           DiscountType
  discountAmount         Int
  currency               String?
  duration               PromoDuration
  durationMonths         Int?
  eligiblePlans          Json           @default("[]")
  maxRedemptions         Int?
  perUserRedemptionLimit Int            @default(1)
  redemptionCount        Int            @default(0)
  startsAt               DateTime?
  expiresAt              DateTime?
  firstTimeCustomersOnly Boolean        @default(false)
  internalOnly           Boolean        @default(false)
  internalNotes          String?        @db.Text
  campaignId             String?
  campaign               PromoCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ambassadorId           String?
  ambassador             Ambassador?    @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  redemptions           PromoRedemption[]
  attributions          ReferralAttribution[]
  manualPaymentRequests ManualPaymentRequest[]

  @@index([status])
  @@index([campaignId])
  @@index([ambassadorId])
  @@index([expiresAt])
  @@index([startsAt])
}

model PromoRedemption {
  id                     String                @id @default(cuid())
  promoCodeId            String
  promoCode              PromoCode             @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  campaignId             String?
  campaign               PromoCampaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ambassadorId           String?
  ambassador             Ambassador?           @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)
  userId                 String?
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan                   Plan?
  discountTypeSnapshot   DiscountType
  discountAmountSnapshot Int
  currencySnapshot       String?
  grossAmountCents       Int                   @default(0)
  discountAmountCents    Int                   @default(0)
  netAmountCents         Int                   @default(0)
  status                 PromoRedemptionStatus @default(REDEEMED)
  checkoutId             String?
  providerReference      String?
  redeemedAt             DateTime              @default(now())
  refundedAt             DateTime?
  createdAt              DateTime              @default(now())

  @@index([promoCodeId, redeemedAt])
  @@index([campaignId, redeemedAt])
  @@index([ambassadorId, redeemedAt])
  @@index([userId])
  @@index([status, redeemedAt])
}

model ReferralAttribution {
  id           String         @id @default(cuid())
  promoCodeId  String?
  promoCode    PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  campaignId   String?
  campaign     PromoCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ambassadorId String?
  ambassador   Ambassador?    @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousKey String?
  eventType    String
  createdAt    DateTime       @default(now())

  @@index([promoCodeId, createdAt])
  @@index([campaignId, createdAt])
  @@index([ambassadorId, createdAt])
  @@index([userId])
  @@index([eventType, createdAt])
}

model PromoAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  plan             Plan
  status           SubscriptionStatus @default(ACTIVE)
  billingInterval  BillingInterval
  startedAt        DateTime
  currentPeriodEnd DateTime?
  activatedAt      DateTime?
  activatedById    String?
  manualPaymentId  String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  manualPayment ManualPaymentRequest? @relation(fields: [manualPaymentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([plan, status])
  @@index([currentPeriodEnd])
}

model ManualPaymentRequest {
  id                 String              @id @default(cuid())
  reference          String              @unique
  userId             String
  selectedPlan       Plan
  billingInterval    BillingInterval
  status             ManualPaymentStatus @default(PENDING_PAYMENT)
  originalAmount     Int
  discountAmount     Int                 @default(0)
  finalAmount        Int
  currency           String              @default("EGP")
  promoCodeId        String?
  promoCodeSnapshot  Json?
  userEmailSnapshot  String
  fullName           String?
  phone              String?
  paymentMethod      String              @default("INSTAPAY")
  createdAt          DateTime            @default(now())
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByMemberId String?
  rejectionReason    String?
  adminNotes         String?             @db.Text
  expiresAt          DateTime?

  promoCode    PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   PlatformMember? @relation("PaymentReviewer", fields: [reviewedByMemberId], references: [id], onDelete: SetNull)
  subscription Subscription?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([selectedPlan, status])
  @@index([promoCodeId])
  @@index([expiresAt])
}

model PlanUsageCycle {
  id                 String   @id @default(cuid())
  userId             String
  plan               Plan
  periodStart        DateTime
  periodEnd          DateTime
  successfulAnalyses Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plan, periodStart])
  @@index([userId, periodEnd])
}
